        "parameters": [
          {
            "name": "loja_id",
            "in": "query",
            "required": false,
            "description": "int — loja do estoque e dos valores; sem ele, a loja da chave (a matriz, se a chave não fixa loja). Uma loja por consulta",
            "schema": {
              "type": "string"
            }
          },
