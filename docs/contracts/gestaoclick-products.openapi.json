            "name": "nome",
            "in": "query",
            "required": false,
            "description": "string — nome do produto: todas as palavras, em qualquer ordem (busca parcial)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "codigo",
            "in": "query",
            "required": false,
            "description": "string — código interno ou código de barras do produto (parcial); o código da variação só exato",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "required": false,
            "description": "string — nome, código interno ou código de barras de uma vez (código de barras exato)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "grupo_id",
            "in": "query",
            "required": false,
            "description": "int — grupo de produtos, já com os subgrupos; SG = só os produtos sem grupo — ids em `/grupos_produtos`",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fornecedor_id",
            "in": "query",
            "required": false,
            "description": "int — produtos ligados a este fornecedor — ids em `/fornecedores`",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ativo",
            "in": "query",
            "required": false,
            "description": "1 = só ativos, 0 = só inativos; sem ele entram os dois",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "situacao",
            "in": "query",
            "required": false,
            "description": "situação do ESTOQUE na loja (só produtos que movimentam estoque): 1 = sem estoque (zero ou negativo), 2 = com estoque, 3 = no mínimo ou abaixo, 4 = no máximo ou acima (3 e 4 só os que têm mínimo/máximo preenchido)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_modificado_inicio",
            "in": "query",
            "required": false,
            "description": "AAAA-MM-DD — só os cadastros alterados a partir deste dia",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_modificado_fim",
            "in": "query",
            "required": false,
            "description": "AAAA-MM-DD — alterados até este dia, EXCLUSIVE: compara com o início do dia, então para incluir o dia mande o dia seguinte",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "atributo",
            "in": "query",
            "required": false,
            "description": "atributo[<id do campo extra>]=texto — produtos com esse conteúdo no campo extra (ex.: atributo[326048]=azul) — ids em `/atributos_produtos`",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Página da listagem",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limite",
            "in": "query",
            "description": "Registros por página (padrão 20, máximo 100; acima de 100 volta 100 sem avisar)",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "ordenacao",
            "in": "query",
            "description": "Campo de ordenação",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direcao",
            "in": "query",
            "description": "asc ou desc",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
