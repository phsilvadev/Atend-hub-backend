APP_ENV=development
DATABASE_URL=sqlite:///./data/atendehub.db
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
COOKIE_SECURE=false
SESSION_HOURS=12
REMEMBER_DAYS=7

# Secrets server-side do app Meta SaaS. Não versionar valores reais.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Gateway não oficial QR Code (opcional). Token compartilhado somente entre servidores.
WHATSAPP_QR_BRIDGE_URL=http://127.0.0.1:8300
WHATSAPP_QR_BRIDGE_TOKEN=

# Token oficial por empresa: chave AES-256 em base64 (NUNCA colocar no frontend).
# Desenvolvimento: python -m app.cli.integration_key (grava .env local sem exibir a chave).
# Produção: gerar e preservar no gerenciador de segredos, separado do banco/backups.
WHATSAPP_CREDENTIAL_KEY=
WHATSAPP_GRAPH_VERSION=v25.0
# App SaaS da plataforma, usado para confirmar a origem/permissões do token.
WHATSAPP_APP_ID=
# URL HTTPS do webhook já implementado; não inclui verify token nem credenciais.
WHATSAPP_PUBLIC_WEBHOOK_URL=

# Firebase Storage (server only). Use the existing bucket name, without gs://.
FIREBASE_STORAGE_BUCKET=
# Optional with workload identity; otherwise an absolute path OUTSIDE the repository.
# Never commit the service-account JSON. No NEXT_PUBLIC_* secret is required.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare Turnstile: production requires enabled=true, REAL keys and exact hostnames.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=[]
# Only for local/automated testing with Cloudflare's official public test pair.
TURNSTILE_TESTING=false
# Railway alternative to a credential file: secret JSON variable, backend only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta Embedded Signup: public Login for Business configuration ID; App Secret remains backend-only.
WHATSAPP_EMBEDDED_CONFIG_ID=
